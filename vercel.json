{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "rewrites": [
    { "source": "/store", "destination": "/index.html" },
    { "source": "/upgrades", "destination": "/index.html" },
    { "source": "/quests", "destination": "/index.html" },
    { "source": "/quests/:tab", "destination": "/index.html" },
    { "source": "/friends", "destination": "/index.html" },
    { "source": "/achievements", "destination": "/index.html" },
    { "source": "/achievements/:tab", "destination": "/index.html" },
    { "source": "/inventory", "destination": "/index.html" },
    { "source": "/inventory/:tab", "destination": "/index.html" },
    { "source": "/global", "destination": "/index.html" },
    { "source": "/general", "destination": "/index.html" },
    { "source": "/general/:tab", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" },
    { "source": "/settings/:tab", "destination": "/index.html" },
    { "source": "/credits", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/features", "destination": "/index.html" },
    { "source": "/how-to-play", "destination": "/index.html" },
    { "source": "/whats-new", "destination": "/index.html" },
    { "source": "/gamemode", "destination": "/index.html" },
    { "source": "/gamemode/:tab", "destination": "/index.html" },
    { "source": "/map-editor", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/models/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }] },
    { "source": "/textures/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }] },
    { "source": "/audio/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=86400" }] }
  ]
}
